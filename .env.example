# Copia este archivo como .env y completa los valores.

# Base de datos: PostgreSQL en Supabase. En el proyecto de Supabase:
# Connect > Direct > Session pooler. Reemplaza [YOUR-PASSWORD] por la contraseña.
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Clave que deben enviar los clientes de la API (ej. el agente de WhatsApp)
# en el header x-api-key. Genera una larga y aleatoria; no la compartas.
FANBASE_API_KEY=""
